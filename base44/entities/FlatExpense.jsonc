{
  "name": "FlatExpense",
  "type": "object",
  "properties": {
    "flat_code": {
      "type": "string",
      "description": "Shared flat group code"
    },
    "title": {
      "type": "string",
      "description": "What the expense is for"
    },
    "amount": {
      "type": "number",
      "description": "Total amount in dollars"
    },
    "category": {
      "type": "string",
      "enum": [
        "rent",
        "utilities",
        "groceries",
        "internet",
        "household",
        "entertainment",
        "other"
      ],
      "description": "Expense category"
    },
    "paid_by": {
      "type": "string",
      "description": "Email of who paid"
    },
    "split_between": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of people splitting the cost"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of expense"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a recurring expense"
    }
  },
  "required": [
    "flat_code",
    "title",
    "amount",
    "category",
    "paid_by"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.paid_by": "{{user.email}}"
        },
        {
          "data.split_between": {
            "$in": [
              "{{user.email}}"
            ]
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.paid_by": "{{user.email}}"
        },
        {
          "data.split_between": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.paid_by": "{{user.email}}"
        },
        {
          "data.split_between": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}